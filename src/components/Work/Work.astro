---
import WorkCard, { type Props as Project } from "./WorkCard.astro";
import "../../styles/Work.css";

const projects: Project[] = [
    {
        number: "01",
        title: "GERMANRIVEROS.CL",
        category: "DIGITAL PLATFORM",
        description:
            "Plataforma digital desarrollada para presentar servicios, proyectos y experiencia profesional, con foco en rendimiento, accesibilidad y experimentación frontend.",
        tags: ["ASTRO", "THREE.JS", "UX/UI", "ACCESSIBILITY"],
        status: "ACTIVE",
        image: "/images/germanriveros-hero.jpg",
        href: "https://germanriveros.cl",
    },
    {
        number: "02",
        title: "THARPA CHILE",
        category: "E-COMMERCE / MAGENTO",
        description:
            "Evolución y mantenimiento de una plataforma e-commerce existente, trabajando sobre Magento para mejorar progresivamente su experiencia y funcionamiento.",
        tags: ["MAGENTO", "E-COMMERCE", "OPTIMIZATION"],
        status: "ACTIVE",
        image: "images/tharpa-hero.jpg",
        href: "https://tharpa.com/cl/",
    },
    {
        number: "03",
        title: "EXPERIMENTOS THREE.JS",
        category: "WEBGL / 3D LABORATORY",
        description:
            "Laboratorio de experimentación con gráficos 3D para la web, explorando Three.js, WebGL y React Three Fiber.",
        tags: ["THREE.JS", "WEBGL", "REACT THREE FIBER"],
        status: "EXPERIMENTAL",
        image: "images/experimentos-hero.jpg",
        href: "https://german-rs.github.io/experimentos-threejs/",
    },
];
---

<section id="work" class="work-section" aria-labelledby="work-title">
    <div class="work-container">
        <header class="work-header">
            <div class="work-header-meta">
                <span class="work-index">02</span>
                <span class="work-system">WORK // SELECTED PROJECTS</span>
            </div>

            <div class="work-heading">
                <p class="work-eyebrow">PROYECTOS SELECCIONADOS</p>

                <h2 id="work-title">
                    Proyectos que administro,
                    <span>optimizo y hago evolucionar.</span>
                </h2>
            </div>

            <p class="work-intro">
                Una selección de proyectos donde convergen administración,
                optimización, accesibilidad y experimentación tecnológica.
            </p>
        </header>

        <div class="work-list">
            {
                projects.map((project) => (
                    <WorkCard {...project} />
                ))
            }
        </div>

        <div class="work-footer">
            <span>03 PROJECTS</span>
            <span>MORE IN PROGRESS</span>
        </div>
    </div>
</section>