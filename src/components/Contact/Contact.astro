---
import "../../styles/Contact.css";

const FORMSPREE_ID = "mzeznogq";
const formAction = `https://formspree.io/f/${FORMSPREE_ID}`;

const facts = [
  { value: "24–48h", label: "Tiempo de respuesta" },
  { value: "Chile", label: "Remoto, cualquier ciudad" },
];

const platforms = ["WordPress", "Magento", "Joomla", "PrestaShop", "Moodle"];
const email = "german.riveross@gmail.com";
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__grid" aria-hidden="true"></div>

  <div class="contact__container">
    <header class="contact__header">
      <div class="contact__meta">
        <span class="contact__eyebrow">05 CONTACT</span>
        <span class="contact__sidebar-label" aria-hidden="true">
          CONTACT // GET IN TOUCH
        </span>
      </div>

      <div class="contact__intro">
        <h2 id="contact-title">
          Hablemos de tu sitio.
          <span> Empecemos con un diagnóstico.</span>
        </h2>
        <p>
          Cuéntame en qué plataforma está tu sitio y qué necesita. Te respondo
          personalmente.
        </p>
      </div>
    </header>

    <div class="contact__body">
      <div class="contact__direct">
        <form
          class="contact__form"
          action={formAction}
          method="POST"
          novalidate
        >
          <div class="contact__field">
            <label for="cf-name">Nombre</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </div>

          <div class="contact__field">
            <label for="cf-email">Correo</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>

          <div class="contact__field">
            <label for="cf-url">Sitio web</label>
            <input
              id="cf-url"
              name="site"
              type="url"
              inputmode="url"
              placeholder="https://tusitio.cl"
            />
          </div>

          <div class="contact__field">
            <label for="cf-platform">Plataforma</label>
            <select id="cf-platform" name="platform">
              <option value="">Selecciona una</option>
              {platforms.map((p) => <option value={p}>{p}</option>)}
              <option value="Otra">Otra / No lo sé</option>
            </select>
          </div>

          <div class="contact__field contact__field--full">
            <label for="cf-message">
              ¿Qué necesita tu sitio? <span>(opcional)</span>
            </label>
            <textarea id="cf-message" name="message" rows="4"></textarea>
          </div>
          <div class="contact__hp" aria-hidden="true">
            <label>
              No llenar
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <input
            type="hidden"
            name="_subject"
            value="Solicitud de diagnóstico (sitio web)"
          />

          <div class="contact__submit-row">
            <button type="submit" class="button button-primary">
              Solicitar diagnóstico <span aria-hidden="true">↗</span>
            </button>
            <p class="contact__submit-note">
              Reviso tu sitio y te respondo con un diagnóstico claro.
            </p>
          </div>

          <p class="contact__privacy">
            Uso tus datos solo para responderte.
          </p>

          <p class="contact__status-msg" role="status" aria-live="polite"></p>
        </form>

        <div class="contact__alt">
          <span class="contact__label">¿PREFIERES ESCRIBIR DIRECTO?</span>

          <div class="contact__email-row">
            <a href={`mailto:${email}`} class="contact__email">
              {email}
            </a>

            <button
              type="button"
              class="contact__copy"
              data-email={email}
              aria-label="Copiar correo electrónico"
            >
              <svg
                class="contact__copy-icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
              </svg>
              <span class="contact__copy-feedback" aria-hidden="true"
                >Copiado</span
              >
            </button>
          </div>
        </div>
      </div>

      <aside class="contact__panel" aria-label="Información de contacto">
        <div class="contact__status">
          <span class="contact__status-dot" aria-hidden="true"></span>
          DISPONIBLE PARA PROYECTOS
        </div>

        <div class="contact__facts">
          {
            facts.map((fact) => (
              <div class="contact__fact">
                <strong>{fact.value}</strong>
                <span>{fact.label}</span>
              </div>
            ))
          }
        </div>

        <div class="contact__panel-block contact__social">
          <a
            href="https://www.instagram.com/germanriveros_cl"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
          <a
            href="https://github.com/german-rs"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </aside>
    </div>
  </div>

  <div class="contact__bottom-line" aria-hidden="true"></div>
</section>

<script>
  // --- Copiar correo ---
  document.querySelectorAll(".contact__copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") || "";

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // Fallback para navegadores sin Clipboard API
        const input = document.createElement("input");
        input.value = email;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      }

      btn.classList.add("is-copied");
      setTimeout(() => btn.classList.remove("is-copied"), 1600);
    });
  });

  // --- Formulario (Formspree) ---
  // Sin JS el formulario igual funciona: el action hace el POST normal.
  const form = document.querySelector<HTMLFormElement>(".contact__form");
  const statusMsg = form?.querySelector<HTMLElement>(".contact__status-msg");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!statusMsg) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submit = form.querySelector<HTMLButtonElement>(
      "button[type=submit]"
    )!;
    submit.disabled = true;
    statusMsg.className = "contact__status-msg";
    statusMsg.textContent = "Enviando…";

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (!res.ok) throw new Error("Respuesta no válida");

      form.reset();
      statusMsg.classList.add("is-success");
      statusMsg.textContent =
        "Mensaje enviado. Te respondo en 24–48 h al correo que indicaste.";
    } catch {
      statusMsg.classList.add("is-error");
      statusMsg.textContent =
        "No se pudo enviar. Inténtalo de nuevo o escríbeme directo al correo.";
    } finally {
      submit.disabled = false;
    }
  });
</script>