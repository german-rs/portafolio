---
import ServiceCard from "./ServiceCard.astro";
import "../../styles/Services.css";

const services = [
  {
    title: "Administración web",
    description: "Mantener tu sitio actualizado, operativo y bajo control.",
    tags: ["Actualizaciones", "Seguridad", "Soporte"],
  },
  {
    title: "Optimización",
    description:
      "Mejorar el rendimiento y la experiencia de uso de forma medible.",
    tags: ["Performance", "Core Web Vitals", "Velocidad"],
  },
  {
    title: "SEO técnico",
    description:
      "Mejorar cómo los buscadores encuentran y entienden tu sitio.",
    tags: ["Meta tags", "Sitemap", "Datos estructurados"],
  },
  {
    title: "Accesibilidad",
    description:
      "Reducir barreras para que más personas puedan utilizar tu sitio.",
    tags: ["WCAG", "Teclado", "Contraste", "Inclusión"],
  },
];
---

<section id="services" class="services" aria-labelledby="services-title">
  <div class="services__container">
    <header class="services__header">
      <div class="services__meta">
        <span class="services__eyebrow"> 03 SERVICES </span>

        <span class="services__sidebar-label" aria-hidden="true">
          SERVICES // CORE OFFERINGS
        </span>
      </div>

      <div class="services__intro">
        <h2 id="services-title">
          Un sitio bien gestionado
          <span> es la base de un negocio que crece.</span>
        </h2>

        <p>
          Tu sitio ya está funcionando. Mi trabajo es ayudar a que siga
          haciéndolo.
        </p>
      </div>
    </header>

    <div class="services__grid">
      {
        services.map((service, i) => (
          <ServiceCard {...service} number={String(i + 1).padStart(2, "0")} />
        ))
      }
    </div>

    <footer class="services__footer">
      <p>¿Tu sitio necesita atención?</p>

      <a href="#contact">
        Solicita un diagnóstico
        <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </div>
</section>
