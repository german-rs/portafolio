---
interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
}

const { number, title, description, tags } = Astro.props;
---

<article class="service-card">
  <div class="service-card__header">
    <span class="service-card__number">{number}</span>

    <span class="service-card__status">
      <span class="service-card__status-dot" aria-hidden="true"></span>
      SERVICE / ACTIVE
    </span>
  </div>

  <div class="service-card__body">
    <h3>{title}</h3>

    <p>{description}</p>
  </div>

  <ul class="service-card__tags" aria-label={`Áreas de ${title}`}>
    {
      tags.map((tag) => (
        <li>{tag}</li>
      ))
    }
  </ul>
</article>