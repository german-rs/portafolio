---
export interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
  accent: "blue" | "teal";
  icon: "admin" | "optimize" | "seo" | "accessibility";
}

const { number, title, description, tags, accent, icon } = Astro.props;
---

<article class={`service-card service-card--${accent}`}>
  <div class="service-card__header">
    <span class="service-card__number">{number}</span>

    <span class="service-card__icon" aria-hidden="true">
      {
        icon === "admin" && (
          <svg
            viewBox="0 0 32 32"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M24.496 22.3667Q25.1 21.7333 25.1 20.8707q0-0.8627-0.604-1.4667t-1.4667-0.604Q22.1667 18.8 21.5333 19.404q-0.6333 0.604-0.6333 1.4667T21.5333 22.3667q0.6333 0.6333 1.496 0.6333 0.8627 0 1.4667-0.6333ZM22.9833 27.1667q1.1167 0 2.0167-0.4667t1.5333-1.3333q-0.8667-0.4667-1.732-0.7t-1.8-0.2333q-0.9347 0-1.818 0.2333T19.4667 25.3667q0.6333 0.8667 1.5167 1.3333t2 0.4667ZM16 29.3333q-4.6-1.0667-7.6333-5.2167T5.3333 14.6v-7.9667l10.6667-4 10.6667 4v9q-0.4667-0.2333-1-0.4167t-1-0.25v-6.9333l-8.6667-3.2-8.6667 3.2v6.5667q0 2.5333 0.8167 4.6667T10.2333 23.0167q1.2667 1.6167 2.8 2.6833t2.9667 1.5333q0.2 0.4 0.6 0.9t0.6667 0.7667q-0.3 0.1667-0.6333 0.25T16 29.3333Zm7.0833 0Q20.5 29.3333 18.6667 27.4833T16.8333 23.1q0-2.6143 1.833-4.4573Q20.4993 16.8 23.1 16.8q2.5667 0 4.4167 1.8427Q29.3667 20.4857 29.3667 23.1q0 2.5333-1.85 4.3833T23.0833 29.3333ZM16 16.0333Z" />
          </svg>
        )
      }
      {
        icon === "optimize" && (
          <svg
            viewBox="0 0 32 32"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M15.7833 21.8833Q17.2333 21.8333 17.9 20.8l7.2-11.3-11.1667 7.3q-1 0.6667-1.0667 2.1333t0.7 2.2333q0.7667 0.7667 2.2167 0.7167ZM15.9333 5.3667q1.9 0 3.9667 0.6167T23.8667 8.1l-1.7333 1.2333q-1.5-1-3.2167-1.4833T15.9327 7.3667q-4.6823 0-7.9743 3.3407Q4.6667 14.0477 4.6667 18.7993 4.6667 20.3 5.0833 21.8333q0.4167 1.5333 1.1833 2.8333h19.3q0.7333-1.2 1.1667-2.8t0.4333-3.1333q0-1.4-0.4167-3.0167T25.2667 12.7333l1.3-1.7333q1.2667 1.8667 1.9 3.75T29.1667 18.5333q0.0667 2-0.4 3.7667t-1.3667 3.2667q-0.4 0.7667-0.85 0.9333t-1.1167 0.1667H6.4q-0.5667 0-1.1167-0.2833T4.4667 25.5667q-0.8667-1.6-1.3333-3.25T2.6667 18.8q0-2.7667 1.05-5.2167t2.85-4.2667Q8.3667 7.5 10.7893 6.4333T15.9333 5.3667Zm-0.3 11.0333Z" />
          </svg>
        )
      }
      {
        icon === "seo" && (
          <svg
            viewBox="0 0 32 32"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M15.2667 29.3q-2.6333-0.1333-4.9333-1.2333t-4-2.8833Q4.6333 23.4 3.65 21.0333T2.6667 16q0-2.7667 1.05-5.2T6.5667 6.5667q1.8-1.8 4.2333-2.85T16 2.6667q4.9667 0 8.6333 3.1333t4.5 7.8667h-2.0333q-0.5667-2.8-2.3667-5t-4.5-3.3v0.6q0 1.1667-0.8 2.0333t-1.9667 0.8667h-2.9v2.9q0 0.5667-0.45 0.9333T13.1 13.0667h-2.7667v2.9333h3.6667v4.1667h-2.2333L4.9667 13.3667q-0.1667 0.6667-0.2333 1.3167t-0.0667 1.3167q0 4.5 3.0333 7.7667t7.5667 3.5333v2Zm13.0667-0.8667L23.8667 23.9667q-0.7 0.5-1.5167 0.7667t-1.6833 0.2667q-2.3667 0-4.0167-1.65T15 19.3333q0-2.3667 1.65-4.0167T20.6667 13.6667q2.3667 0 4.0167 1.65T26.3333 19.3333q0 0.8667-0.2833 1.6833T25.3 22.5667l4.4667 4.4333-1.4333 1.4333ZM23.2667 21.9333q1.0667-1.0667 1.0667-2.6t-1.0667-2.6q-1.0667-1.0667-2.6-1.0667t-2.6 1.0667q-1.0667 1.0667-1.0667 2.6t1.0667 2.6q1.0667 1.0667 2.6 1.0667t2.6-1.0667Z" />
          </svg>
        )
      }
      {
        icon === "accessibility" && (
          <svg
            viewBox="0 0 32 32"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M14.2833 6.8167Q13.5667 6.1 13.5667 5.1t0.7167-1.7167Q15 2.6667 16 2.6667t1.7167 0.7167Q18.4333 4.1 18.4333 5.1t-0.7167 1.7167Q17 7.5333 16 7.5333t-1.7167-0.7167ZM12.4333 29.3333v-17.7667q-2.2667-0.1667-4.3833-0.4667T4 10.3333l0.5-2q2.8333 0.6667 5.6333 0.95t5.8667 0.2833q3.0667 0 5.8667-0.2833T27.5 8.3333l0.5 2q-1.9333 0.4667-4.05 0.7667T19.5667 11.5667v17.7667h-2v-8.6667h-3.1333v8.6667h-2Z" />
          </svg>
        )
      }
    </span>
  </div>

  <div class="service-card__body">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>

  <ul class="service-card__tags" aria-label={`Áreas de ${title}`}>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>
