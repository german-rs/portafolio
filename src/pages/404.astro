---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/404.css";
---

<BaseLayout
  title="404 — Recurso no encontrado | Germán Riveros"
  description="La página que buscas no existe."
  noindex
>
  <section class="error-page" aria-labelledby="error-title">
    <div class="error-page__grid" aria-hidden="true"></div>
    <div class="error-page__glow" aria-hidden="true"></div>

    <div class="error-page__content">
      <div class="error-page__header">
        <span class="error-page__label">SYS.ERROR // HTTP 404</span>
        <span class="error-page__code" aria-hidden="true">404</span>
      </div>

      <div class="error-page__message">
        <h1 id="error-title">Este recurso no existe.</h1>
        <p>
          La dirección que buscas no está disponible o ya no existe en este
          sitio.
        </p>
        <a href="/" class="button button-primary error-page__button">
          Volver al inicio <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="error-page__status">
        <div class="error-page__status-item">
          <span class="error-page__status-label">STATUS</span>
          <span class="error-page__status-value">
            <span class="error-page__status-dot" aria-hidden="true"></span>
            SYSTEM ONLINE
          </span>
        </div>
        <div class="error-page__status-item">
          <span class="error-page__status-label">REQUEST</span>
          <span class="error-page__status-value error-page__request">
            {Astro.url.pathname}
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>