---
import "../styles/global.css";
import Hero from "../components/Hero/Hero.astro";
import Work from "../components/Work/Work.astro";
import Services from "../components/Services/Services.astro";
import About from "../components/About/About.astro";
import Contact from "../components/Contact/Contact.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Germán Riveros — Administración y Mantención Web</title>

        <meta
            name="description"
            content="Administración y mantención de sitios WordPress y otras plataformas en Chile. Incluye atención en Lengua de Señas Chilena."
        />
    </head>

    <body>
        <div class="site-shell">
            <header class="site-header">
                <a href="/" class="brand" aria-label="Germán Riveros — Inicio">
                    Germán Riveros
                </a>

                <nav class="main-nav" aria-label="Navegación principal">
                    <a href="#work">Work</a>
                    <a href="#services">Services</a>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </nav>

                <a href="#contact" class="header-cta"> Get in Touch </a>
            </header>

            <main>
                <Hero />

                <Work />

                <Services />

                <About />
                
                <Contact />

            </main>

            <footer class="site-footer">
                <p>
                    © 2026 Germán Riveros — Technical Humanist. Built with
                    precision.
                </p>

                <div class="footer-links">
                    <a href="https://www.instagram.com/germanriveros_cl"
                        >Instagram</a
                    >
                    <a href="https://github.com/german-rs">GitHub</a>
                    <a href="mailto:german.riveross@gmail.com">Email</a>
                </div>
            </footer>
        </div>
    </body>
</html>