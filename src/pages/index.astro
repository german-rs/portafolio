---
import "../styles/global.css";
import Hero from "../components/Hero/Hero.astro";
import Work from "../components/Work/Work.astro";
import Services from "../components/Services/Services.astro";
import About from "../components/About/About.astro";
import Contact from "../components/Contact/Contact.astro";
---

<!doctype html>
<html lang="es">
    <head>
        
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Germán Riveros — Administración y Mantención Web</title>

        <meta
            name="description"
            content="Administración y mantención de sitios WordPress y otras plataformas en Chile. Incluye atención en Lengua de Señas Chilena."
        />

        <!-- Google Tag Manager (vía Partytown, corre en un web worker) -->
        <script type="text/partytown">
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-M3PZ4MKW");
        </script>
        <!-- End Google Tag Manager -->
    </head>

    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-M3PZ4MKW"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->

        <div class="site-shell">
            <header class="site-header">
                <a href="/" class="brand" aria-label="Germán Riveros — Inicio">
                    Germán Riveros
                </a>

                <nav class="main-nav" aria-label="Navegación principal">
                    <a href="#work">Work</a>
                    <a href="#services">Services</a>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </nav>

                <a href="#contact" class="header-cta"> Get in Touch </a>
            </header>

            <main>
                <Hero />

                <Work />

                <Services />

                <About />
                
                <Contact />

            </main>

            <footer class="site-footer">
                <p>
                    © 2026 Germán Riveros — Technical Humanist. Built with
                    precision.
                </p>

                <div class="footer-links">
                    <a href="https://www.instagram.com/germanriveros_cl"
                        >Instagram</a
                    >
                    <a href="https://github.com/german-rs">GitHub</a>
                    <a href="mailto:german.riveross@gmail.com">Email</a>
                </div>
            </footer>
        </div>
    </body>
</html>

