---
import "../styles/global.css";
import Work from "../components/Work/Work.astro";
import Services from "../components/Services/Services.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Germán Riveros — Administración y Mantención Web</title>

        <meta
            name="description"
            content="Administración y mantención de sitios WordPress y otras plataformas en Chile. Incluye atención en Lengua de Señas Chilena."
        />
    </head>

    <body>
        <div class="site-shell">
            <!-- ========================================
           HEADER
      ========================================= -->

            <header class="site-header">
                <a href="/" class="brand" aria-label="Germán Riveros — Inicio">
                    Germán Riveros
                </a>

                <nav class="main-nav" aria-label="Navegación principal">
                    <a href="#work">Work</a>
                    <a href="#services">Services</a>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </nav>

                <a href="#contact" class="header-cta"> Get in Touch </a>
            </header>

            <!-- ========================================
           HERO
      ========================================= -->

            <main>
                <section class="hero" aria-labelledby="hero-title">
                    <div class="hero-grid"></div>

                    <div class="hero-glow"></div>

                    <!-- Icosaedro decorativo. Solo desktop, respeta
                         prefers-reduced-motion (ver hero-icosaedro.js).
                         aria-hidden porque es puramente ambiental, no aporta
                         información. -->
                    <div class="hero-icosaedro-wrap" aria-hidden="true">
                        <canvas id="hero-icosaedro"></canvas>
                    </div>

                    <div class="hero-system">SYS.INIT // V1.1</div>

                    <div class="hero-content">
                        <p class="hero-eyebrow">
                            ADMINISTRACIÓN WEB · OPTIMIZACIÓN · ACCESIBILIDAD
                        </p>

                        <h1 id="hero-title">
                            Si tienes un sitio.
                            <span>Que siga funcionando es mi trabajo.</span>
                        </h1>

                        <p class="hero-description">
                            Administración y optimización de sitios WordPress y otras plataformas en Chile.
                        </p>

                        <div class="hero-actions">
                            <a href="#contact" class="button button-primary">
                                Solicita un diagnóstico
                            </a>

                            <a href="#services" class="button button-secondary">
                                Ver resultados
                            </a>
                        </div>
                    </div>

                    <div class="hero-bottom-line"></div>
                </section>

                <!-- ========================================
             PLACEHOLDERS
             Se construirán en los siguientes pasos
        ========================================= -->

               <Work />

              <Services />

                <section id="about" class="placeholder-section">
                    <span>ABOUT</span>
                </section>

                <section id="contact" class="placeholder-section">
                    <span>CONTACT</span>
                </section>
            </main>

            <!-- ========================================
           FOOTER
      ========================================= -->

            <footer class="site-footer">
                <p>
                    © 2026 Germán Riveros — Technical Humanist. Manage with
                    precision.
                </p>

                <div class="footer-links">
                    <a href="https://www.instagram.com/germanriveros_cl">Instagram</a>
                    <a href="https://github.com/german-rs">GitHub</a>
                    <a href="mailto:german.riveross@gmail.com">Email</a>
                </div>
            </footer>
        </div>

        <script>
            import "../scripts/hero-icosaedro.js";
        </script>
    </body>
</html>
