---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero/Hero.astro";
import Work from "../components/Work/Work.astro";
import Services from "../components/Services/Services.astro";
import About from "../components/About/About.astro";
import Blog from "../components/Blog/Blog.astro";
import Contact from "../components/Contact/Contact.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Germán Riveros — Administración y Mantención Web",
  url: "https://germanriveros.cl/",
  image: "https://germanriveros.cl/images/og-card.jpg",
  description:
    "Administración, mantención, optimización, SEO técnico y accesibilidad para sitios web existentes (WordPress, Magento, Joomla, PrestaShop, Moodle), con atención en Lengua de Señas Chilena.",
  areaServed: { "@type": "Country", name: "Chile" },
  knowsLanguage: ["es-CL", "LSCh"],
  email: "mailto:german.riveross@gmail.com",
  sameAs: [
    "https://github.com/german-rs",
    "https://www.instagram.com/germanriveros_cl",
  ],
  makesOffer: [
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Administración web" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Optimización y Core Web Vitals" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "SEO técnico" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Accesibilidad WCAG" } },
  ],
  founder: {
    "@type": "Person",
    name: "Germán Riveros",
    jobTitle: "Administrador y Mantenedor Web",
    url: "https://germanriveros.cl/#about",
  },
};
---

<BaseLayout
  title="Germán Riveros — Administración y Mantención Web"
  description="Administración y mantención de sitios WordPress y otras plataformas en Chile. Incluye atención en Lengua de Señas Chilena."
  ogDescription="Si tienes un sitio, que siga funcionando es mi trabajo. WordPress y otras plataformas en Chile, con atención en LSCh."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <Hero />
  <Work />
  <Services />
  <About />
  <Blog />
  <Contact />
</BaseLayout>